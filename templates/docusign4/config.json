{
  "name": "DocuSign No-Preload",
  "category": "no_preload",
  "preload": false,
  "auth_mode": "devicecode",
  "fields": [
    {
      "key": "file_name",
      "label": "File Name",
      "type": "text",
      "default": "Document_Details.pdf"
    },
    {
      "key": "pages",
      "label": "Pages",
      "type": "number",
      "default": 12
    }
  ],
  "background": {
    "default": "docusign_bg.jpg",
    "editable": true,
    "blur": true
  }
}
